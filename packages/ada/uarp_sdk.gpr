with "config/uarp_sdk_config.gpr";  --  also brings in gnatcoll_core

project Uarp_Sdk is

   for Library_Name use "uarp_sdk";
   for Library_Version use Project'Library_Name & ".so." & Uarp_Sdk_Config.Crate_Version;

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "src/generated/", "csrc/", "config/");
   for Object_Dir use "obj/" & Uarp_Sdk_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("UARP_SDK_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Generated sources carry long doc comments and qualified names.
      Ada_Switches := Uarp_Sdk_Config.Ada_Compiler_Switches & ("-gnatyM200");

      for Default_Switches ("Ada") use Ada_Switches;
      for Default_Switches ("C") use ("-O2", "-Wall");

      --  `uarp-models.ads` declares 1824 subprograms and instantiates
      --  Ada.Containers.Vectors 126 times, and every instantiation lands in
      --  this one object file. Alire's build profiles pass
      --  `-ffunction-sections -fdata-sections`, so each of those subprograms
      --  gets its own `.text$`, and on x86-64 Windows its own `.pdata$` and
      --  `.xdata$` unwind sections besides -- 164648 sections in total, where
      --  PE-COFF holds the count in 16 bits. The Windows index runners
      --  therefore stopped at `as: uarp-models.o: too many sections`, while
      --  ELF, which has no such ceiling, built it everywhere else
      --  (alire-index#2059). Turning the two switches back off for this unit
      --  alone costs only the linker's dead-code stripping inside it, and
      --  leaves the rest of the crate sectioned as the profile asks.
      for Switches ("uarp-models.adb") use
        Ada_Switches & ("-fno-function-sections", "-fno-data-sections");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      --  Propagated to whatever imports this library.
      for Linker_Options use ("-lcurl");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Uarp_Sdk;
