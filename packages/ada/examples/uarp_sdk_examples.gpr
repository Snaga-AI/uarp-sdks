with "config/uarp_sdk_examples_config.gpr";
with "uarp_sdk.gpr";

project Uarp_Sdk_Examples is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Uarp_Sdk_Examples_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("quickstart.adb", "contract.adb");

   package Compiler is
      for Default_Switches ("Ada") use Uarp_Sdk_Examples_Config.Ada_Compiler_Switches & ("-gnatyM200");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-lcurl");
   end Linker;

end Uarp_Sdk_Examples;
