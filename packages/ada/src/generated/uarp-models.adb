   function To_Run_Step_Status (Value : String) return Run_Step_Status is
   begin
      if Value = "running" then
         return (Kind => Run_Step_Status_Running, Raw => UARP.Types."+" (Value));
      elsif Value = "completed" then
         return (Kind => Run_Step_Status_Completed, Raw => UARP.Types."+" (Value));
      elsif Value = "failed" then
         return (Kind => Run_Step_Status_Failed, Raw => UARP.Types."+" (Value));
      else
         return (Kind => Run_Step_Status_Unrecognized, Raw => UARP.Types."+" (Value));
      end if;
   end To_Run_Step_Status;

   function To_Run_Step_Status (Kind : Run_Step_Status_Kind) return Run_Step_Status is
   begin
      case Kind is
         when Run_Step_Status_Running =>
            return (Kind => Kind, Raw => UARP.Types."+" ("running"));
         when Run_Step_Status_Completed =>
            return (Kind => Kind, Raw => UARP.Types."+" ("completed"));
         when Run_Step_Status_Failed =>
            return (Kind => Kind, Raw => UARP.Types."+" ("failed"));
         when Run_Step_Status_Unrecognized =>
            return (Kind => Kind, Raw => UARP.Types.Empty_Text);
      end case;
   end To_Run_Step_Status;

