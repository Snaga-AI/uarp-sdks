   function To_Memory_Entry_Type (Value : String) return Memory_Entry_Type is
   begin
      if Value = "episodic" then
         return (Kind => Memory_Entry_Type_Episodic, Raw => UARP.Types."+" (Value));
      elsif Value = "semantic" then
         return (Kind => Memory_Entry_Type_Semantic, Raw => UARP.Types."+" (Value));
      elsif Value = "procedural" then
         return (Kind => Memory_Entry_Type_Procedural, Raw => UARP.Types."+" (Value));
      elsif Value = "note" then
         return (Kind => Memory_Entry_Type_Note, Raw => UARP.Types."+" (Value));
      else
         return (Kind => Memory_Entry_Type_Unrecognized, Raw => UARP.Types."+" (Value));
      end if;
   end To_Memory_Entry_Type;

   function To_Memory_Entry_Type (Kind : Memory_Entry_Type_Kind) return Memory_Entry_Type is
   begin
      case Kind is
         when Memory_Entry_Type_Episodic =>
            return (Kind => Kind, Raw => UARP.Types."+" ("episodic"));
         when Memory_Entry_Type_Semantic =>
            return (Kind => Kind, Raw => UARP.Types."+" ("semantic"));
         when Memory_Entry_Type_Procedural =>
            return (Kind => Kind, Raw => UARP.Types."+" ("procedural"));
         when Memory_Entry_Type_Note =>
            return (Kind => Kind, Raw => UARP.Types."+" ("note"));
         when Memory_Entry_Type_Unrecognized =>
            return (Kind => Kind, Raw => UARP.Types.Empty_Text);
      end case;
   end To_Memory_Entry_Type;

