   function To_Integration_Catalog_Item_Auth_Type (Value : String) return Integration_Catalog_Item_Auth_Type is
   begin
      if Value = "api_key" then
         return (Kind => Integration_Catalog_Item_Auth_Type_API_Key, Raw => UARP.Types."+" (Value));
      elsif Value = "oauth2" then
         return (Kind => Integration_Catalog_Item_Auth_Type_Oauth2, Raw => UARP.Types."+" (Value));
      elsif Value = "webhook" then
         return (Kind => Integration_Catalog_Item_Auth_Type_Webhook, Raw => UARP.Types."+" (Value));
      elsif Value = "none" then
         return (Kind => Integration_Catalog_Item_Auth_Type_None, Raw => UARP.Types."+" (Value));
      else
         return (Kind => Integration_Catalog_Item_Auth_Type_Unrecognized, Raw => UARP.Types."+" (Value));
      end if;
   end To_Integration_Catalog_Item_Auth_Type;

   function To_Integration_Catalog_Item_Auth_Type (Kind : Integration_Catalog_Item_Auth_Type_Kind) return Integration_Catalog_Item_Auth_Type is
   begin
      case Kind is
         when Integration_Catalog_Item_Auth_Type_API_Key =>
            return (Kind => Kind, Raw => UARP.Types."+" ("api_key"));
         when Integration_Catalog_Item_Auth_Type_Oauth2 =>
            return (Kind => Kind, Raw => UARP.Types."+" ("oauth2"));
         when Integration_Catalog_Item_Auth_Type_Webhook =>
            return (Kind => Kind, Raw => UARP.Types."+" ("webhook"));
         when Integration_Catalog_Item_Auth_Type_None =>
            return (Kind => Kind, Raw => UARP.Types."+" ("none"));
         when Integration_Catalog_Item_Auth_Type_Unrecognized =>
            return (Kind => Kind, Raw => UARP.Types.Empty_Text);
      end case;
   end To_Integration_Catalog_Item_Auth_Type;

