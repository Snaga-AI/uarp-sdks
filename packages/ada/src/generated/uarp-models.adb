   function To_Resource_Permission_Action (Value : String) return Resource_Permission_Action is
   begin
      if Value = "read" then
         return (Kind => Resource_Permission_Action_Read, Raw => UARP.Types."+" (Value));
      elsif Value = "write" then
         return (Kind => Resource_Permission_Action_Write, Raw => UARP.Types."+" (Value));
      elsif Value = "delete" then
         return (Kind => Resource_Permission_Action_Delete, Raw => UARP.Types."+" (Value));
      elsif Value = "execute" then
         return (Kind => Resource_Permission_Action_Execute, Raw => UARP.Types."+" (Value));
      else
         return (Kind => Resource_Permission_Action_Unrecognized, Raw => UARP.Types."+" (Value));
      end if;
   end To_Resource_Permission_Action;

   function To_Resource_Permission_Action (Kind : Resource_Permission_Action_Kind) return Resource_Permission_Action is
   begin
      case Kind is
         when Resource_Permission_Action_Read =>
            return (Kind => Kind, Raw => UARP.Types."+" ("read"));
         when Resource_Permission_Action_Write =>
            return (Kind => Kind, Raw => UARP.Types."+" ("write"));
         when Resource_Permission_Action_Delete =>
            return (Kind => Kind, Raw => UARP.Types."+" ("delete"));
         when Resource_Permission_Action_Execute =>
            return (Kind => Kind, Raw => UARP.Types."+" ("execute"));
         when Resource_Permission_Action_Unrecognized =>
            return (Kind => Kind, Raw => UARP.Types.Empty_Text);
      end case;
   end To_Resource_Permission_Action;

