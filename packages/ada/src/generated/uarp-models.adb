   function To_Product_Type (Value : String) return Product_Type is
   begin
      if Value = "course" then
         return (Kind => Product_Type_Course, Raw => UARP.Types."+" (Value));
      elsif Value = "service" then
         return (Kind => Product_Type_Service, Raw => UARP.Types."+" (Value));
      elsif Value = "digital" then
         return (Kind => Product_Type_Digital, Raw => UARP.Types."+" (Value));
      elsif Value = "subscription" then
         return (Kind => Product_Type_Subscription, Raw => UARP.Types."+" (Value));
      else
         return (Kind => Product_Type_Unrecognized, Raw => UARP.Types."+" (Value));
      end if;
   end To_Product_Type;

   function To_Product_Type (Kind : Product_Type_Kind) return Product_Type is
   begin
      case Kind is
         when Product_Type_Course =>
            return (Kind => Kind, Raw => UARP.Types."+" ("course"));
         when Product_Type_Service =>
            return (Kind => Kind, Raw => UARP.Types."+" ("service"));
         when Product_Type_Digital =>
            return (Kind => Kind, Raw => UARP.Types."+" ("digital"));
         when Product_Type_Subscription =>
            return (Kind => Kind, Raw => UARP.Types."+" ("subscription"));
         when Product_Type_Unrecognized =>
            return (Kind => Kind, Raw => UARP.Types.Empty_Text);
      end case;
   end To_Product_Type;

   function Image (Model : Product_Type) return String is
      (if UARP.Types.SU.Length (Model.Raw) > 0
         then UARP.Types.SU.To_String (Model.Raw)
         else UARP.Types.SU.To_String (To_Product_Type (Model.Kind).Raw));

   function To_JSON (Model : Product_Type) return UARP.JSON_Support.JSON_Value is
      (JS.JSON.Create (Image (Model)));

   function From_JSON (Node : UARP.JSON_Support.JSON_Value) return Product_Type is
      (To_Product_Type (UARP.Types."+" (JS.As_Text (Node))));

