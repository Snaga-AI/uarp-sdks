{
  "openapi": "3.1.0",
  "info": {
    "title": "Nullability",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.test"
    }
  ],
  "paths": {
    "/things/{thingId}": {
      "get": {
        "operationId": "getThing",
        "summary": "Fetch a thing",
        "tags": [
          "Things"
        ],
        "security": [
          {
            "bearerAuth": [
              "things:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "thingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              }
            }
          }
        }
      }
    },
    "/envelopes": {
      "get": {
        "operationId": "listEnvelopes",
        "tags": [
          "Things"
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/things/{thingId}/schedule": {
      "get": {
        "operationId": "getThingSchedule",
        "summary": "A thing's schedule, or null when it has none",
        "tags": [
          "Things"
        ],
        "parameters": [
          {
            "name": "thingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The schedule, or null in the body when none is set",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Owner"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "description": "Every shape of optionality the spec uses.",
        "required": [
          "id",
          "required_nullable",
          "count",
          "owner",
          "rehearsal",
          "shape"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "required_nullable": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present but may be null."
          },
          "count": {
            "type": "integer"
          },
          "optional_plain": {
            "type": "number"
          },
          "optional_nullable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "legacy_nullable": {
            "type": "object",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "free_form": {
            "type": "object"
          },
          "anything": {
            "type": "object",
            "additionalProperties": true
          },
          "deprecated_field": {
            "type": "string",
            "deprecated": true
          },
          "kind": {
            "type": "string",
            "const": "thing"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner",
            "description": "A plain reference: always an object."
          },
          "rehearsal": {
            "$ref": "#/components/schemas/Rehearsal",
            "description": "The component itself admits null, so the reference does too."
          },
          "shape": {
            "$ref": "#/components/schemas/Shape",
            "description": "Null spelled as a oneOf member on the component."
          }
        }
      },
      "Envelope": {
        "type": "object",
        "description": "Declares additionalProperties, so unmodelled keys must survive.",
        "required": [
          "id"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "Owner": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Rehearsal": {
        "type": [
          "object",
          "null"
        ],
        "description": "Null until the first rehearsal.",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          }
        }
      },
      "Shape": {
        "description": "Null when the cron has no simple shape.",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "every"
            ],
            "properties": {
              "every": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
