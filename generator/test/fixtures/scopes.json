{
  "openapi": "3.1.0",
  "info": { "title": "Scopes", "version": "1.0.0" },
  "servers": [{ "url": "https://api.test" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/agents": {
      "get": {
        "operationId": "listAgents",
        "summary": "List agents",
        "tags": ["Agents"],
        "x-scopes": ["agents:read"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      },
      "post": {
        "operationId": "createAgent",
        "summary": "Create an agent",
