          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health",
        "tags": ["Health"],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "x-scopes": {
          "agents:read": "Read agents.",
          "agents:write": "Write agents.",
          "billing:read": "Read billing."
        }
      }
    }
  }
